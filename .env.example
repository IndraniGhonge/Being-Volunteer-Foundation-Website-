# Copy this file to ".env" and change the values.
PORT=3000
NODE_ENV=development

# A long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=BVF_Secure_Secret_2026_Random9xK7pL2mQ8

# First admin account (created automatically on first start if none exists)
ADMIN_USER=adminA
ADMIN_PASSWORD=admin123

# Where the database and uploaded images are stored.
# On a hosting service, point this to a persistent disk/volume.
DATA_DIR=./data

# true = add 6 sample events on first start (set false for the real site)
SEED_DEMO=true
